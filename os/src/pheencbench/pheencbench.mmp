// pheencbench.mmp -- OURS: A64 hardware VE H.264 encoder vs OpenH264 software
// encoding on the A53 cores (1 and 4 threads, NEON) at five resolutions, plus RGB->NV12/I420 colour conversion cost. "[encbench]" lines.
// SSM_TEST=pheencbench. The OpenH264 archive: bash tools/codecpack/openh264_enc.sh (BSD-2-Clause; registry arm_archives).
TARGET			pheencbench.exe
TARGETTYPE		exe
UID				0x1000007a 0xE70157F7
CAPABILITY		All -TCB
VENDORID		0
EPOCHEAPSIZE	0x100000 0x10000000
EPOCSTACKSIZE	0x40000

OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		../phorepoc-arm/vde ../phevdec ../phevenctest ../../.codecpack/openh264-arm/include
SOURCEPATH		.
SOURCE			bench_main.cpp bench_common.cpp enc_sw.cpp enc_hw.cpp
SOURCEPATH		../phevdec
SOURCE			h264_parser.cpp ve_h264.cpp
STATICLIBRARY	libcrt0.lib
LIBRARY			libc.lib libm.lib libpthread.lib
LIBRARY			euser.lib hal.lib
SMPSAFE
