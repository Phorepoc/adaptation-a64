// pherecenc.mmp -- OURS (2026-11-06): the screen recorder's H.264 encoder plug-in (pherecenc.cpp): the Video Engine's
// hardware encoder. H.264 is patent-encumbered, so it is never in an image (registry: device-only) but this repository's
// Catalogue package (package.conf, recipes/sis.sh); the image's pherec.exe (src/pherec) loads it by name and ordinal 1.
TARGET			pherecenc.dll
TARGETTYPE		dll
UID				0x1000008d 0xE7015813
CAPABILITY		All -TCB
VENDORID		0

OS_LAYER_SYSTEMINCLUDE
USERINCLUDE		. ../pherec ../phorepoc-arm/vde ../phevdec ../phevenctest
SOURCEPATH		.
SOURCE			pherecenc.cpp ve_enc.cpp
LIBRARY			euser.lib hal.lib
SMPSAFE
