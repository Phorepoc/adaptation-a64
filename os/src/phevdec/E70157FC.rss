// E70157FC.rss -- OURS (VDU V4): ECOM registration of the A64 Video Engine DevVideo decoder (interface 0x101FB4BE =
// KUidDevVideoDecoderHwDevice, the one CMMFDevVideoPlay::FindDecodersL / SelectDecoderL look under).
#include <ecom/registryinfo.rh>

RESOURCE REGISTRY_INFO theInfo
    {
    dll_uid     = 0xE70157FC;
    interfaces  =
        {
        INTERFACE_INFO
            {
            interface_uid   = 0x101FB4BE;
            implementations =
                {
                IMPLEMENTATION_INFO
                    {
                    implementation_uid  = 0xE70157FD;
                    version_no          = 1;
                    display_name        = "Phorepoc software decoder (MPEG-4 Part 2)";
                    // the MIME types it decodes, matched (with wildcards) against the query; '||' separates them
                    default_data        = "video/mp4v-es*||";
                    // the post-processing it does itself (TPrePostProcessType bits): none
                    opaque_data         = "0";
                    }
                };
            }
        };
    }
