// phevdec_sw.mmp -- OURS (Path C x86, 2026-10-16): the same DevVideo decoder hardware device as phevdec.mmp (same UIDs, same
// ECOM registration, the image is also named phevdec.dll) but decoding in SOFTWARE through the separate LGPL pheffmpeg.dll
// (PheVid* ordinals): the x86 board has no Video Engine. PHE_SW compiles out everything VE-specific (phevdec.h/.cpp);
// h264_parser.cpp stays for GetHeaderInformationL. x32 only: `./ph build phevdec_sw`.
TARGET			phevdec.dll
TARGETTYPE		PLUGIN
UID				0x10009D8D 0xE70157C2
CAPABILITY		All -TCB
VENDORID		0

MACRO			PHE_SW
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
USERINCLUDE		.
SOURCEPATH		.
SOURCE			phevdec.cpp h264_parser.cpp

START RESOURCE	E70157C2.rss
TARGET			phevdec.rsc
END

LIBRARY			euser.lib devvideo.lib hal.lib
